+static int mac_main(void)
+{
+	int res = 1;
+	FILE *Fpid = NULL;
+	uint8_t *mod = NULL;
+	uint64_t bt, bt_next, dbt;
+
+	if (*params.pidfile && !(Fpid = fopen(params.pidfile, "w")))
+	{
+		DLOG_PERROR("create pidfile");
+		return 1;
+	}
+	if (params.intercept && !darwin_capture_init()) goto exiterr;
+	if (!rawsend_preinit(false, false)) goto exiterr;
+	print_id();
+	if (!lua_test_init_script_files()) goto exiterr;
+	catch_signals();
+	if (!lua_init()) goto exiterr;
+	do_fuzz();
+
+	if (!params.intercept)
+	{
+		NoInterceptLoop();
+		goto exitok;
+	}
+	if (!(mod = malloc(RECONSTRUCT_MAX_SIZE)))
+	{
+		DLOG_ERR("out of memory\n");
+		goto exiterr;
+	}
+	if (params.daemon) daemonize();
+	if (!write_pidfile(&Fpid)) goto exiterr;
+	DLOG_CONDUP("PFLOG_READY %s\n", getenv("IGARECK_DARWIN_PFLOG"));
 
+	for (bt = bt_next = 0;;)
+	{
+		if (bQuit) goto exitok;
+		if (params.timers)
+		{
+			if (!bt_next) bt_next = TimerPoolNext(params.timers, &params.timers_dirty);
+			bt = boottime_ms();
+			dbt = bt_next > bt ? bt_next - bt : 0;
+			if (dbt > 1000) dbt = 1000;
+		}
+		size_t length = 0;
+		bool incoming = false;
+		const uint8_t *packet = darwin_recv(&length, &incoming);
+		if (bQuit) goto exitok;
+		if (!packet)
+		{
+			if (errno != EINTR && errno != EAGAIN && errno != 0)
+			{
+				DLOG_PERROR("darwin: receive");
+				goto exiterr;
+			}
+		}
+		else
+		{
+			uint32_t mark = 0;
+			size_t modlen = RECONSTRUCT_MAX_SIZE;
+			const char *ifin = incoming ? darwin_interface() : "";
+			const char *ifout = incoming ? "" : darwin_interface();
+			uint8_t verdict = processPacketData(&mark, ifin, ifout, packet, length, mod, &modlen);
+			if (!incoming)
+			{
+				switch (verdict & VERDICT_MASK)
+				{
+				case VERDICT_PASS:
+					if (!darwin_send(packet, length)) DLOG_ERR("darwin: original packet was not sent\n");
+					break;
+				case VERDICT_MODIFY:
+					if (!darwin_send(mod, modlen)) DLOG_ERR("darwin: modified packet was not sent\n");
+					break;
+				default:
+					break;
+				}
+			}
+		}
+		ReloadCheck();
+		lua_do_gc();
+		if (params.timers)
+		{
+			bt = boottime_ms();
+			if (bt >= bt_next) bt_next = TimerPoolRun(&params.timers, &params.timers_dirty, bt);
+			else if (params.timers_dirty) bt_next = 0;
+		}
+	}
+
+exitok:
+	res = 0;
+exiterr:
+	if (Fpid) fclose(Fpid);
+	free(mod);
+	lua_shutdown();
+	rawsend_cleanup();
+	return res;
+}
